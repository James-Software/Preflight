# Copy to .env.local and fill in. Do NOT commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Current GitHub/Auth.js login (web app only).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
AUTH_URL=

# Current app database (Neon/Postgres). Also set in the Trigger.dev worker environment.
DATABASE_URL=

# Web app: choose the Trigger.dev key for this deployment's environment.
# Production on Vercel must use this project's tr_prod_... key.
TRIGGER_SECRET_KEY=
# Preview-only: defaults to VERCEL_GIT_COMMIT_REF; must name a deployed worker branch.
# TRIGGER_PREVIEW_BRANCH=
# Local development only; empty/default uses the root dev worker.
# TRIGGER_DEV_BRANCH=

# Trigger.dev workers: add these in the matching worker environment, then deploy.
# Browserbase credentials are also needed in the web app for browser-assisted profiles.
# Direct OpenAI key: pass/fail and severity judgments via /v1/decisions.
OPENAI_API_KEY=
# OpenRouter key: browser-driving model calls.
OPENROUTER_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BLOB_READ_WRITE_TOKEN=
# These are the defaults; remove stale worker overrides or set them explicitly.
# JUDGE_PROVIDER=openai-decisions
# JUDGE_MODEL=gpt-6-luna
# DRIVER_MODEL=openai/gpt-6-luna
# Explicit legacy fallback: JUDGE_PROVIDER=openrouter-chat and JUDGE_MODEL=openai/gpt-4o-mini

# Shared by the web app and workers: encrypted auth profiles/database connections.
# Generate once: openssl rand -base64 32
PROFILE_ENCRYPTION_KEY=

# Optional provider account sign-in (web app only). Token autofill also works without OAuth apps.
# Supabase app scopes: projects:read and database:read.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Neon OAuth requires partner approval. An account API key is available as a fallback.
NEON_OAUTH_CLIENT_ID=
NEON_OAUTH_CLIENT_SECRET=
